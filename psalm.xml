<?xml version="1.0"?>
<psalm
    phpVersion="7.4"
    errorLevel="1"
    resolveFromConfigFile="true"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
	reportMixedIssues="false"
    findUnusedCode="false"
    errorBaseline="psalm.baseline.xml"
>
    <projectFiles>
        <directory name="app" />
        <directory name="tests" />
        <ignoreFiles>
            <directory name="vendor" />
        </ignoreFiles>
    </projectFiles>
	
	<fileExtensions>
		<extension name=".php" />
		<extension name=".phtml" />
	</fileExtensions>
	
	<issueHandlers>
	   <TooManyTemplateParams errorLevel="info" />
	   <ClassMustBeFinal errorLevel="suppress" /> 
	   <InvalidClassConstantType>
           <errorLevel type="suppress">
            <referencedConstant name="MyArtJaub\Webtrees\Module\Certificates\Http\RequestHandlers\AutoCompleteFile::CACHE_LIFE" />
           </errorLevel>
	   </InvalidClassConstantType>
       <TooManyArguments>
           <errorLevel type="suppress">
               <referencedFunction name="Illuminate\Database\Query\Builder::select" />
               <referencedFunction name="ReflectionMethod::invoke" />
           </errorLevel>
       </TooManyArguments>
       <UndefinedMagicMethod>
            <errorLevel type="suppress">
               <referencedMethod name="Illuminate\Database\Capsule\Manager::raw" />
               <referencedMethod name="Illuminate\Database\Capsule\Manager::query" />
            </errorLevel>
       </UndefinedMagicMethod>
       <PropertyNotSetInConstructor>
            <errorLevel type="suppress">
                <directory name="tests" />
            </errorLevel>
       </PropertyNotSetInConstructor>
	</issueHandlers>
</psalm>
